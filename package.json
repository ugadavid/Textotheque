{
  "name": "textotheque",
  "productName": "Textotheque",
  "version": "0.1.17",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "postinstall": "npm run rebuild:electron",
    "rebuild:electron": "node scripts/rebuild-electron-native.cjs",
    "dev": "concurrently -k \"vite\" \"npm:dev:electron\"",
    "dev:electron": "wait-on http://localhost:5173 && tsc -p electron/tsconfig.json && electron dist-electron/main.js",
    "build": "tsc -b && vite build && tsc -p electron/tsconfig.json",
    "start": "npm run build && electron dist-electron/main.js",
    "test:db": "tsc -p electron/tsconfig.json && electron scripts/electron-db-check.cjs",
    "test:preload": "tsc -p electron/tsconfig.json && electron scripts/electron-preload-api-check.cjs",
    "test:ui-safeguards": "npm run build && electron scripts/electron-ui-safeguards-check.cjs",
    "test:app-identity": "npm run build && node scripts/electron-app-identity-check.cjs",
    "test:ipc-error": "npm run build && node scripts/electron-ipc-error-check.cjs",
    "test:electron-sqlite": "electron scripts/electron-sqlite-smoke.cjs",
    "test:legacy-migration": "tsc -p electron/tsconfig.json && electron scripts/electron-legacy-migration-check.cjs",
    "test:library": "tsc -p electron/tsconfig.json && electron scripts/electron-library-check.cjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "better-sqlite3": "^11.8.1",
    "concurrently": "^9.1.2",
    "electron": "^33.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
